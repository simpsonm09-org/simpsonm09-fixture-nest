  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
